{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "strict": true,
        "esModuleInterop": true,
        "noEmit": true,
        "rootDir": "./src",
        "declaration": false,
        "sourceMap": true,
        "inlineSources": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}
