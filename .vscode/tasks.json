{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"label": "npm: build",
			"detail": "npm run build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			// The preLaunchTask of .vscode/launch.json. A shell task rather than an "npm" one so
			// that VS Code resolves it from this file, instead of asking every task provider it
			// has for a task with this label.
			"label": "Build+Deploy+Start Vortex",
			"detail": "npm run debug",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"debug"
			],
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		}
	]
}
